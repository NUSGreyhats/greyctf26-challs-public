diff --git a/Objects/dictobject.c b/Objects/dictobject.c
index 254cd9a..3bb2462 100644
--- a/Objects/dictobject.c
+++ b/Objects/dictobject.c
@@ -232,6 +232,29 @@ equally good collision statistics, needed less code & used less memory.
 
 */
 
+bool grey_lock = 0;
+
+static PyObject *dict_grey(PyDictObject *mp) {
+    if (grey_lock) {
+        Py_RETURN_FALSE;
+    } else {
+        grey_lock++;
+
+        size_t entry_size = DK_IS_UNICODE(mp->ma_keys) ? sizeof(PyDictUnicodeEntry) : sizeof(PyDictKeyEntry);
+        size_t used_size = entry_size * mp->ma_keys->dk_nentries;
+
+        void* buf = PyMem_Malloc(used_size);
+
+        memcpy(buf, DK_ENTRIES(mp->ma_keys), used_size);
+        mp->ma_keys->dk_log2_index_bytes--;
+        memcpy(DK_ENTRIES(mp->ma_keys), buf, used_size);
+
+
+        Py_RETURN_TRUE;
+    }
+}
+
+
 static int dictresize(PyInterpreterState *interp, PyDictObject *mp,
                       uint8_t log_newsize, int unicode);
 
@@ -1375,6 +1398,7 @@ insert_to_emptydict(PyInterpreterState *interp, PyDictObject *mp,
 /*
 Internal routine used by dictresize() to build a hashtable of entries.
 */
+
 static void
 build_indices_generic(PyDictKeysObject *keys, PyDictKeyEntry *ep, Py_ssize_t n)
 {
@@ -3681,6 +3705,7 @@ static PyMethodDef mapp_methods[] = {
      copy__doc__},
     DICT___REVERSED___METHODDEF
     {"__class_getitem__", Py_GenericAlias, METH_O|METH_CLASS, PyDoc_STR("See PEP 585")},
+    {"grey", (void *)dict_grey, METH_NOARGS, "samuzora"},
     {NULL,              NULL}   /* sentinel */
 };
 
